#!/bin/bash

# home-manager directory hash: {{ output "sh" "-c" (printf "find %s/dot_config/home-manager -type f -print0 | xargs -0 sha256sum | sort | sha256sum" .chezmoi.sourceDir) }}

# Run the Home Manager pinned in flake.lock, with this flake's nixpkgs (root's `nixpkgs` input)
# so the tool is built from the same nixpkgs as the configuration. Reading the node literally
# named "nixpkgs" is wrong: it can be an unused leftover, while root.inputs points at e.g. nixpkgs_3.
{{- $lock := include (printf "%s/dot_config/home-manager/flake.lock" .chezmoi.sourceDir) | fromJson }}
{{- $nixpkgs := (index $lock.nodes (index $lock.nodes.root.inputs "nixpkgs")).locked }}
{{- $hm := (index $lock.nodes "home-manager").locked }}
nix run \
  --override-input nixpkgs "github:{{ $nixpkgs.owner }}/{{ $nixpkgs.repo }}/{{ $nixpkgs.rev }}" \
  "github:{{ $hm.owner }}/{{ $hm.repo }}/{{ $hm.rev }}" \
  -- switch --flake ~/.config/home-manager
proto regen

