[user]
	name = {{ .identity.name }}
	email = {{ .identity.email }}
	signingkey = {{ .identity.signingkey }}
{{ if stat .ssh_signing.program -}}
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = {{ .ssh_signing.program }}
{{ end -}}
[credential "https://github.com"]
	helper =
	helper = !{{ .chezmoi.homeDir }}/.nix-profile/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ .chezmoi.homeDir }}/.nix-profile/bin/gh auth git-credential
[ghq]
	root = ~/wip/git
[init]
	templateDir = ~/.config/git/templates
