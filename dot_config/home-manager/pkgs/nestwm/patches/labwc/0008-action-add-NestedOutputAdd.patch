+static void
+get_wl_backend(struct wlr_backend *backend, void *data)
+{
+	if (wlr_backend_is_wl(backend)) {
+		struct wlr_backend **wl = data;
+		*wl = backend;
+	}
+}
+
+void
+output_nested_add(void)
+{
+	struct wlr_backend *wl_backend = NULL;
+	if (wlr_backend_is_multi(server.backend)) {
+		wlr_multi_for_each_backend(server.backend, get_wl_backend,
+			&wl_backend);
+	} else if (wlr_backend_is_wl(server.backend)) {
+		wl_backend = server.backend;
+	}
+	if (!wl_backend) {
+		wlr_log(WLR_ERROR, "cannot add a nested output: not running nested");
+		return;
+	}
+	if (!wlr_wl_output_create(wl_backend)) {
+		wlr_log(WLR_ERROR, "failed to create a nested output");
+	}
+}
