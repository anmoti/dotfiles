 #define LAB_CURSOR_SHAPE_V1_VERSION 1
 
 struct constraint {
@@ -182,6 +187,98 @@ set_xcursor(struct seat *seat, const char *parent_name, const char *name)
 	wlr_cursor_set_xcursor(seat->cursor, seat->xcursor_manager, name);
 }
 
+#if HAVE_XWAYLAND
+/* X11 (Xcursor) names for the cursor-shape-v1 ones, others are passed as is */
+static const char *
+x11_cursor_shape(const char *name)
+{
+	static const char *const map[][2] = {
+		{ "left_ptr", "default" }, { "arrow", "default" },
+		{ "top_left_arrow", "default" },
+		{ "xterm", "text" }, { "ibeam", "text" },
+		{ "hand1", "pointer" }, { "hand2", "pointer" },
+		{ "pointing_hand", "pointer" },
+		{ "watch", "wait" }, { "left_ptr_watch", "progress" },
+		{ "question_arrow", "help" }, { "whats_this", "help" },
+		{ "cross", "crosshair" }, { "tcross", "crosshair" },
+		{ "fleur", "move" }, { "size_all", "move" },
+		{ "openhand", "grab" }, { "closedhand", "grabbing" },
+		{ "dnd-none", "grabbing" },
+		{ "X_cursor", "not-allowed" }, { "forbidden", "not-allowed" },
+		{ "circle", "not-allowed" },
+		{ "sb_h_double_arrow", "ew-resize" }, { "size_hor", "ew-resize" },
+		{ "h_double_arrow", "ew-resize" },
+		{ "sb_v_double_arrow", "ns-resize" }, { "size_ver", "ns-resize" },
+		{ "v_double_arrow", "ns-resize" },
+		{ "size_fdiag", "nwse-resize" }, { "size_bdiag", "nesw-resize" },
+		{ "top_left_corner", "nw-resize" }, { "top_right_corner", "ne-resize" },
+		{ "bottom_left_corner", "sw-resize" },
+		{ "bottom_right_corner", "se-resize" },
+		{ "top_side", "n-resize" }, { "bottom_side", "s-resize" },
+		{ "left_side", "w-resize" }, { "right_side", "e-resize" },
+		{ "split_h", "col-resize" }, { "split_v", "row-resize" },
+		{ "plus", "cell" }, { "copy", "copy" }, { "link", "alias" },
+	};
+	for (size_t i = 0; i < ARRAY_SIZE(map); i++) {
+		if (!strcmp(map[i][0], name)) {
+			return map[i][1];
+		}
+	}
+	return name;
+}
+
+/* Last cursor image requested by Xwayland, used when X11's is unnamed */
+static struct {
+	struct wlr_surface *surface;
+	int32_t hotspot_x, hotspot_y;
+	struct wl_listener destroy;
+} xwayland_cursor;
+
+static void
+handle_xwayland_cursor_destroy(struct wl_listener *listener, void *data)
+{
+	wl_list_remove(&xwayland_cursor.destroy.link);
+	xwayland_cursor.surface = NULL;
+}
+
+static bool
+is_xwayland_client(struct wlr_seat_client *seat_client)
+{
+	return seat_client && server.xwayland && server.xwayland->server
+		&& seat_client->client == server.xwayland->server->client;
+}
+
+/* Let the parent draw X11's cursor if it's a named (themed) one */
+static void
+set_xwayland_cursor(struct seat *seat)
+{
+	const char *name = server.xwayland->cursor_name;
+	if (name && set_parent_cursor(x11_cursor_shape(name))) {
+		wlr_log(WLR_DEBUG, "X11 cursor '%s' drawn by the parent", name);
+		wlr_cursor_unset_image(seat->cursor);
+		return;
+	}
+	wlr_log(WLR_DEBUG, "X11 cursor '%s' drawn from its image",
+		name ? name : "(none)");
+	set_parent_cursor(NULL);
+	if (xwayland_cursor.surface) {
+		wlr_cursor_set_surface(seat->cursor, xwayland_cursor.surface,
+			xwayland_cursor.hotspot_x, xwayland_cursor.hotspot_y);
+	}
+}
+
+void
+cursor_xwayland_name_changed(struct seat *seat)
+{
+	if (server.input_mode == LAB_INPUT_STATE_PASSTHROUGH
+			&& seat->cursor_visible
+			&& seat->server_cursor == LAB_CURSOR_CLIENT
+			&& is_xwayland_client(seat->wlr_seat->pointer_state.focused_client)) {
+		set_xwayland_cursor(seat);
+	}
+}
+#endif
+
 static void
 handle_request_set_cursor(struct wl_listener *listener, void *data)
 {
@@ -233,6 +330,24 @@ handle_request_set_cursor(struct wl_listener *listener, void *data)
 		 * continue to do so as the cursor moves between outputs.
 		 */
 
+#if HAVE_XWAYLAND
+		if (is_xwayland_client(event->seat_client)) {
+			if (xwayland_cursor.surface) {
+				wl_list_remove(&xwayland_cursor.destroy.link);
+			}
+			xwayland_cursor.surface = event->surface;
+			xwayland_cursor.hotspot_x = event->hotspot_x;
+			xwayland_cursor.hotspot_y = event->hotspot_y;
+			if (event->surface) {
+				xwayland_cursor.destroy.notify =
+					handle_xwayland_cursor_destroy;
+				wl_signal_add(&event->surface->events.destroy,
+					&xwayland_cursor.destroy);
+			}
+			set_xwayland_cursor(seat);
+			return;
+		}
+#endif
 		/* The client draws it, the parent only shows our output */
 		set_parent_cursor(NULL);
 		wlr_cursor_set_surface(seat->cursor, event->surface,
