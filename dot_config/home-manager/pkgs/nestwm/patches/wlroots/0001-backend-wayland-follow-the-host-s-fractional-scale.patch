From c2e8b54e13a1641e178bd06efa1b0770ea6d3c6b Mon Sep 17 00:00:00 2001
From: anmoti <77442643+anmoti@users.noreply.github.com>
Date: Wed, 30 Sep 2026 08:46:20 +0900
Subject: [PATCH 1/9] backend/wayland: follow the host's fractional scale

Bind wp_fractional_scale_manager_v1 and render nested outputs at
logical size * preferred scale, mapping the buffer back to the logical
size with wp_viewport. Absolute pointer/touch/tablet coordinates and the
cursor surface are converted accordingly.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012X41FaHDG1j8zRZcCfwo6r
---
 backend/wayland/backend.c   |  7 +++
 backend/wayland/meson.build |  1 +
 backend/wayland/output.c    | 85 +++++++++++++++++++++++++++++++++++--
 backend/wayland/pointer.c   |  4 +-
 backend/wayland/seat.c      |  4 +-
 backend/wayland/tablet_v2.c |  4 +-
 include/backend/wayland.h   | 10 ++++-
 7 files changed, 104 insertions(+), 11 deletions(-)

diff --git a/backend/wayland/backend.c b/backend/wayland/backend.c
index 14a783b6..a4848752 100644
--- a/backend/wayland/backend.c
+++ b/backend/wayland/backend.c
@@ -20,6 +20,7 @@
 #include "render/pixel_format.h"
 
 #include "drm-client-protocol.h"
+#include "fractional-scale-v1-client-protocol.h"
 #include "linux-dmabuf-v1-client-protocol.h"
 #include "linux-drm-syncobj-v1-client-protocol.h"
 #include "pointer-gestures-unstable-v1-client-protocol.h"
@@ -416,6 +417,9 @@ static void registry_global(void *data, struct wl_registry *registry,
 	} else if (strcmp(iface, wp_viewporter_interface.name) == 0) {
 		wl->viewporter = wl_registry_bind(registry, name,
 			&wp_viewporter_interface, 1);
+	} else if (strcmp(iface, wp_fractional_scale_manager_v1_interface.name) == 0) {
+		wl->fractional_scale_manager = wl_registry_bind(registry, name,
+			&wp_fractional_scale_manager_v1_interface, 1);
 	} else if (strcmp(iface, wp_linux_drm_syncobj_manager_v1_interface.name) == 0) {
 		wl->drm_syncobj_manager_v1 = wl_registry_bind(registry, name,
 			&wp_linux_drm_syncobj_manager_v1_interface, 1);
@@ -553,6 +557,9 @@ static void backend_destroy(struct wlr_backend *backend) {
 	if (wl->viewporter) {
 		wp_viewporter_destroy(wl->viewporter);
 	}
+	if (wl->fractional_scale_manager) {
+		wp_fractional_scale_manager_v1_destroy(wl->fractional_scale_manager);
+	}
 	free(wl->drm_render_name);
 	free(wl->activation_token);
 	xdg_wm_base_destroy(wl->xdg_wm_base);
diff --git a/backend/wayland/meson.build b/backend/wayland/meson.build
index b606a9bb..cc786aed 100644
--- a/backend/wayland/meson.build
+++ b/backend/wayland/meson.build
@@ -13,6 +13,7 @@ wlr_files += files(
 
 client_protos = [
 	'drm',
+	'fractional-scale-v1',
 	'linux-dmabuf-v1',
 	'linux-drm-syncobj-v1',
 	'pointer-gestures-unstable-v1',
diff --git a/backend/wayland/output.c b/backend/wayland/output.c
index fb4d1f91..4b5a6212 100644
--- a/backend/wayland/output.c
+++ b/backend/wayland/output.c
@@ -1,4 +1,5 @@
 #include <assert.h>
+#include <math.h>
 #include <stdint.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -20,6 +21,7 @@
 #include "render/pixel_format.h"
 #include "types/wlr_output.h"
 
+#include "fractional-scale-v1-client-protocol.h"
 #include "linux-dmabuf-v1-client-protocol.h"
 #include "linux-drm-syncobj-v1-client-protocol.h"
 #include "presentation-time-client-protocol.h"
@@ -792,6 +794,12 @@ static bool output_commit(struct wlr_output *wlr_output, const struct wlr_output
 
 		wl_surface_attach(output->surface, buffer->wl_buffer, 0, 0);
 		damage_surface(output->surface, damage);
+
+		if (output->viewport != NULL) {
+			wp_viewport_set_destination(output->viewport,
+				round(wlr_buffer->width / output->scale),
+				round(wlr_buffer->height / output->scale));
+		}
 	}
 
 	if (state->committed & WLR_OUTPUT_STATE_WAIT_TIMELINE) {
@@ -908,8 +916,9 @@ static bool output_set_cursor(struct wlr_output *wlr_output,
 	struct wlr_wl_output *output = get_wl_output_from_output(wlr_output);
 	struct wlr_wl_backend *backend = output->backend;
 
-	output->cursor.hotspot_x = hotspot_x;
-	output->cursor.hotspot_y = hotspot_y;
+	// The cursor buffer is rendered at the output scale
+	output->cursor.hotspot_x = round(hotspot_x / output->scale);
+	output->cursor.hotspot_y = round(hotspot_y / output->scale);
 
 	if (output->cursor.surface == NULL) {
 		output->cursor.surface =
@@ -917,6 +926,11 @@ static bool output_set_cursor(struct wlr_output *wlr_output,
 	}
 	struct wl_surface *surface = output->cursor.surface;
 
+	if (output->cursor.viewport == NULL && output->viewport != NULL) {
+		output->cursor.viewport =
+			wp_viewporter_get_viewport(backend->viewporter, surface);
+	}
+
 	if (wlr_buffer != NULL) {
 		struct wlr_wl_buffer *buffer =
 			get_or_create_wl_buffer(output->backend, wlr_buffer);
@@ -924,6 +938,11 @@ static bool output_set_cursor(struct wlr_output *wlr_output,
 			return false;
 		}
 
+		if (output->cursor.viewport != NULL) {
+			wp_viewport_set_destination(output->cursor.viewport,
+				fmax(1, round(wlr_buffer->width / output->scale)),
+				fmax(1, round(wlr_buffer->height / output->scale)));
+		}
 		wl_surface_attach(surface, buffer->wl_buffer, 0, 0);
 		wl_surface_damage_buffer(surface, 0, 0, INT32_MAX, INT32_MAX);
 		wl_surface_commit(surface);
@@ -958,6 +977,9 @@ static void output_destroy(struct wlr_output *wlr_output) {
 
 	wl_list_remove(&output->link);
 
+	if (output->cursor.viewport) {
+		wp_viewport_destroy(output->cursor.viewport);
+	}
 	if (output->cursor.surface) {
 		wl_surface_destroy(output->cursor.surface);
 	}
@@ -979,6 +1001,12 @@ static void output_destroy(struct wlr_output *wlr_output) {
 	if (output->drm_syncobj_surface_v1) {
 		wp_linux_drm_syncobj_surface_v1_destroy(output->drm_syncobj_surface_v1);
 	}
+	if (output->fractional_scale) {
+		wp_fractional_scale_v1_destroy(output->fractional_scale);
+	}
+	if (output->viewport) {
+		wp_viewport_destroy(output->viewport);
+	}
 	if (output->zxdg_toplevel_decoration_v1) {
 		zxdg_toplevel_decoration_v1_destroy(output->zxdg_toplevel_decoration_v1);
 	}
@@ -1036,14 +1064,15 @@ static void xdg_surface_handle_configure(void *data,
 	struct wlr_wl_output *output = data;
 	assert(output && output->xdg_surface == xdg_surface);
 
+	// The host configures in logical coordinates; the mode is in pixels
 	int32_t req_width = output->wlr_output.width;
 	int32_t req_height = output->wlr_output.height;
 	if (output->requested_width > 0) {
-		req_width = output->requested_width;
+		req_width = round(output->requested_width * output->scale);
 		output->requested_width = 0;
 	}
 	if (output->requested_height > 0) {
-		req_height = output->requested_height;
+		req_height = round(output->requested_height * output->scale);
 		output->requested_height = 0;
 	}
 
@@ -1064,10 +1093,44 @@ static void xdg_surface_handle_configure(void *data,
 	struct wlr_output_state state;
 	wlr_output_state_init(&state);
 	wlr_output_state_set_custom_mode(&state, req_width, req_height, 0);
+	if (output->fractional_scale != NULL &&
+			output->wlr_output.scale != (float)output->scale) {
+		wlr_output_state_set_scale(&state, output->scale);
+	}
+	wlr_output_send_request_state(&output->wlr_output, &state);
+	wlr_output_state_finish(&state);
+}
+
+static void fractional_scale_handle_preferred_scale(void *data,
+		struct wp_fractional_scale_v1 *fractional_scale, uint32_t scale_120) {
+	struct wlr_wl_output *output = data;
+	double scale = scale_120 / 120.0;
+	if (scale == output->scale) {
+		return;
+	}
+
+	// Keep the logical size, re-render at the new scale
+	int32_t width = round(output->wlr_output.width / output->scale * scale);
+	int32_t height = round(output->wlr_output.height / output->scale * scale);
+	output->scale = scale;
+
+	if (!output->wlr_output.enabled) {
+		// Applied on the first configure after enabling
+		return;
+	}
+
+	struct wlr_output_state state;
+	wlr_output_state_init(&state);
+	wlr_output_state_set_custom_mode(&state, width, height, 0);
+	wlr_output_state_set_scale(&state, scale);
 	wlr_output_send_request_state(&output->wlr_output, &state);
 	wlr_output_state_finish(&state);
 }
 
+static const struct wp_fractional_scale_v1_listener fractional_scale_listener = {
+	.preferred_scale = fractional_scale_handle_preferred_scale,
+};
+
 static const struct xdg_surface_listener xdg_surface_listener = {
 	.configure = xdg_surface_handle_configure,
 };
@@ -1130,6 +1193,7 @@ static struct wlr_wl_output *output_create(struct wlr_wl_backend *backend,
 
 	output->surface = surface;
 	output->backend = backend;
+	output->scale = 1;
 	wl_list_init(&output->presentation_feedbacks);
 
 	wl_proxy_set_tag((struct wl_proxy *)output->surface, &surface_tag);
@@ -1201,6 +1265,19 @@ struct wlr_output *wlr_wl_output_create(struct wlr_backend *wlr_backend) {
 			ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE);
 	}
 
+	if (backend->fractional_scale_manager && backend->viewporter) {
+		output->viewport =
+			wp_viewporter_get_viewport(backend->viewporter, output->surface);
+		output->fractional_scale = wp_fractional_scale_manager_v1_get_fractional_scale(
+			backend->fractional_scale_manager, output->surface);
+		if (!output->viewport || !output->fractional_scale) {
+			wlr_log_errno(WLR_ERROR, "Could not set up fractional scaling");
+			goto error;
+		}
+		wp_fractional_scale_v1_add_listener(output->fractional_scale,
+			&fractional_scale_listener, output);
+	}
+
 	if (!update_title(output, NULL)) {
 		wlr_log_errno(WLR_ERROR, "Could not allocate xdg toplevel title");
 		goto error;
diff --git a/backend/wayland/pointer.c b/backend/wayland/pointer.c
index b61e32cd..89e50718 100644
--- a/backend/wayland/pointer.c
+++ b/backend/wayland/pointer.c
@@ -92,8 +92,8 @@ static void pointer_handle_motion(void *data, struct wl_pointer *wl_pointer,
 	struct wlr_pointer_motion_absolute_event event = {
 		.pointer = &pointer->wlr_pointer,
 		.time_msec = time,
-		.x = wl_fixed_to_double(sx) / wlr_output->width,
-		.y = wl_fixed_to_double(sy) / wlr_output->height,
+		.x = wl_fixed_to_double(sx) * pointer->output->scale / wlr_output->width,
+		.y = wl_fixed_to_double(sy) * pointer->output->scale / wlr_output->height,
 	};
 	wl_signal_emit_mutable(&pointer->wlr_pointer.events.motion_absolute, &event);
 }
diff --git a/backend/wayland/seat.c b/backend/wayland/seat.c
index f178d9ba..e42a14de 100644
--- a/backend/wayland/seat.c
+++ b/backend/wayland/seat.c
@@ -121,8 +121,8 @@ static void touch_coordinates_to_absolute(struct wlr_wl_seat *seat,
 	 */
 	struct wlr_wl_output *output, *tmp;
 	wl_list_for_each_safe(output, tmp, &seat->backend->outputs, link) {
-		*sx = wl_fixed_to_double(x) / output->wlr_output.width;
-		*sy = wl_fixed_to_double(y) / output->wlr_output.height;
+		*sx = wl_fixed_to_double(x) * output->scale / output->wlr_output.width;
+		*sy = wl_fixed_to_double(y) * output->scale / output->wlr_output.height;
 		return; // Choose the first output in the list
 	}
 
diff --git a/backend/wayland/tablet_v2.c b/backend/wayland/tablet_v2.c
index 3f6a16ee..bf916a74 100644
--- a/backend/wayland/tablet_v2.c
+++ b/backend/wayland/tablet_v2.c
@@ -534,8 +534,8 @@ static void handle_tablet_tool_motion(void *data, struct zwp_tablet_tool_v2 *id,
 	struct wlr_wl_output *output = tool->output;
 	assert(output);
 
-	tool->x = wl_fixed_to_double(x) / output->wlr_output.width;
-	tool->y = wl_fixed_to_double(y) / output->wlr_output.height;
+	tool->x = wl_fixed_to_double(x) * output->scale / output->wlr_output.width;
+	tool->y = wl_fixed_to_double(y) * output->scale / output->wlr_output.height;
 }
 
 static void handle_tablet_tool_pressure(void *data,
diff --git a/include/backend/wayland.h b/include/backend/wayland.h
index e24eb9fd..460b931c 100644
--- a/include/backend/wayland.h
+++ b/include/backend/wayland.h
@@ -53,6 +53,7 @@ struct wlr_wl_backend {
 	struct xdg_activation_v1 *activation_v1;
 	struct wl_subcompositor *subcompositor;
 	struct wp_viewporter *viewporter;
+	struct wp_fractional_scale_manager_v1 *fractional_scale_manager;
 	char *drm_render_name;
 };
 
@@ -108,6 +109,12 @@ struct wlr_wl_output {
 	struct wp_linux_drm_syncobj_surface_v1 *drm_syncobj_surface_v1;
 	struct wl_list presentation_feedbacks;
 
+	// Fractional scale preferred by the host compositor. The output renders
+	// at logical size * scale and wp_viewport maps it back to logical size.
+	struct wp_fractional_scale_v1 *fractional_scale;
+	struct wp_viewport *viewport;
+	double scale; // 1 if the host doesn't support fractional-scale-v1
+
 	char *title;
 	char *app_id;
 
@@ -129,7 +136,8 @@ struct wlr_wl_output {
 	struct {
 		struct wlr_wl_pointer *pointer;
 		struct wl_surface *surface;
-		int32_t hotspot_x, hotspot_y;
+		struct wp_viewport *viewport;
+		int32_t hotspot_x, hotspot_y; // surface-local (logical) coordinates
 	} cursor;
 };
 
