 	wl_list_remove(&xwayland->server_ready.link);
 	wl_list_remove(&xwayland->shell_destroy.link);
+	wl_list_remove(&xwayland->compositor_new_surface.link);
 	wlr_buffer_unlock(xwayland->cursor_buffer);
 
 	wlr_xwayland_set_seat(xwayland, NULL);
@@ -107,6 +143,11 @@ struct wlr_xwayland *wlr_xwayland_create_with_server(struct wl_display *wl_displ
 
 	xwayland->wl_display = wl_display;
 	xwayland->compositor = compositor;
+	xwayland->scale = 1;
+
+	xwayland->compositor_new_surface.notify = handle_compositor_new_surface;
+	wl_signal_add(&compositor->events.new_surface,
+		&xwayland->compositor_new_surface);
 
 	wl_signal_init(&xwayland->events.destroy);
 	wl_signal_init(&xwayland->events.new_surface);
