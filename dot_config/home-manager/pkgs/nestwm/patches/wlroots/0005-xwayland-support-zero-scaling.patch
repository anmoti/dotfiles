 		wl_resource_for_each(resource, &client->pointers) {
 			if (wlr_seat_client_from_pointer_resource(resource) == NULL) {
@@ -576,7 +586,8 @@ void seat_client_create_pointer(struct wlr_seat_client *seat_client,
 				}
 
