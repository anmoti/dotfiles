@@ -174,6 +174,15 @@ struct wlr_surface {
 	 */
 	struct wlr_surface_state current, pending;
 
+	/**
+	 * Extra downscale applied on top of the client's own buffer scale, for
+	 * clients unaware of the output scale (Xwayland with zero scaling). The
