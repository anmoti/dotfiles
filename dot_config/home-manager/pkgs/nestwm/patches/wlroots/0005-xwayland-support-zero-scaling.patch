+static bool is_xwayland_resource(struct wlr_xwayland *xwayland,
+		struct wl_resource *resource) {
+	return xwayland->server != NULL && xwayland->server->client != NULL &&
+		wl_resource_get_client(resource) == xwayland->server->client;
+}
+
+static void handle_compositor_new_surface(struct wl_listener *listener,
+		void *data) {
+	struct wlr_xwayland *xwayland =
+		wl_container_of(listener, xwayland, compositor_new_surface);
+	struct wlr_surface *surface = data;
+	if (is_xwayland_resource(xwayland, surface->resource)) {
+		surface->client_scale = xwayland->scale;
+	}
+}
+
+static enum wl_iterator_result set_surface_scale(struct wl_resource *resource,
+		void *data) {
+	if (strcmp(wl_resource_get_class(resource), "wl_surface") == 0) {
+		wlr_surface_from_resource(resource)->client_scale = *(float *)data;
+	}
+	return WL_ITERATOR_CONTINUE;
+}
+
+void wlr_xwayland_set_scale(struct wlr_xwayland *xwayland, float scale) {
+	xwayland->scale = scale;
+	if (xwayland->server != NULL && xwayland->server->client != NULL) {
+		// Applied on the surfaces' next commit
+		wl_client_for_each_resource(xwayland->server->client,
+			set_surface_scale, &scale);
+	}
+}
+
 static void handle_server_ready(struct wl_listener *listener, void *data) {
 	struct wlr_xwayland *xwayland =
 		wl_container_of(listener, xwayland, server_ready);
@@ -86,6 +121,7 @@ void wlr_xwayland_destroy(struct wlr_xwayland *xwayland) {
