diff --git a/types/wlr_compositor.c b/types/wlr_compositor.c
index 75faed19..e370acde 100644
--- a/types/wlr_compositor.c
+++ b/types/wlr_compositor.c
@@ -1,4 +1,5 @@
 #include <assert.h>
+#include <math.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <wayland-server-core.h>
@@ -243,6 +244,12 @@ static void surface_finalize_pending(struct wlr_surface *surface) {
 	pixman_region32_intersect_rect(&pending->buffer_damage,
 		&pending->buffer_damage, 0, 0, pending->buffer_width,
 		pending->buffer_height);
+
+	// Client coordinates -> compositor coordinates (see client_scale)
+	if (surface->client_scale != 1) {
+		pending->width = round(pending->width / surface->client_scale);
+		pending->height = round(pending->height / surface->client_scale);
+	}
 }
 
 static void surface_update_damage(pixman_region32_t *buffer_damage,
@@ -457,14 +464,20 @@ static void surface_update_opaque_region(struct wlr_surface *surface) {
 		return;
 	}
 
+	// ponytail: scaling rounds outwards, so the opaque region may grow by a
+	// pixel at fractional client_scale; shrink it if that ever shows
+	wlr_region_scale(&surface->opaque_region, &surface->current.opaque,
+		1.0 / surface->client_scale);
 	pixman_region32_intersect_rect(&surface->opaque_region,
-		&surface->current.opaque,
+		&surface->opaque_region,
 		0, 0, surface->current.width, surface->current.height);
 }
 
 static void surface_update_input_region(struct wlr_surface *surface) {
+	wlr_region_scale(&surface->input_region, &surface->current.input,
+		1.0 / surface->client_scale);
 	pixman_region32_intersect_rect(&surface->input_region,
-		&surface->current.input,
+		&surface->input_region,
 		0, 0, surface->current.width, surface->current.height);
 }
 
