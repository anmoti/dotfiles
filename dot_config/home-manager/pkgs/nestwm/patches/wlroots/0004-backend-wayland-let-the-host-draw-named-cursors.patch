@@ -916,9 +918,11 @@ static bool output_set_cursor(struct wlr_output *wlr_output,
 	struct wlr_wl_output *output = get_wl_output_from_output(wlr_output);
 	struct wlr_wl_backend *backend = output->backend;
 
-	// The cursor buffer is rendered at the output scale
-	output->cursor.hotspot_x = round(hotspot_x / output->scale);
-	output->cursor.hotspot_y = round(hotspot_y / output->scale);
+	if (wlr_buffer == NULL && output->cursor.shape != 0) {
+		// Keep the cursor drawn by the host, see wlr_wl_output_set_cursor_name()
+		return true;
+	}
+	output->cursor.shape = 0;
 
 	if (output->cursor.surface == NULL) {
 		output->cursor.surface =
@@ -926,10 +930,18 @@ static bool output_set_cursor(struct wlr_output *wlr_output,
 	}
 	struct wl_surface *surface = output->cursor.surface;
 
-	if (output->cursor.viewport == NULL && output->viewport != NULL) {
-		output->cursor.viewport =
-			wp_viewporter_get_viewport(backend->viewporter, surface);
+	// The cursor buffer is rendered at the output scale. Hosts may ignore
+	// wp_viewport on cursor surfaces, so only integer scales are expressible:
+	// otherwise hide the host cursor and let wlroots draw a software one.
+	if (wlr_buffer != NULL && output->scale != floor(output->scale)) {
+		wl_surface_attach(surface, NULL, 0, 0);
+		wl_surface_commit(surface);
+		update_wl_output_cursor(output);
+		wl_display_flush(backend->remote_display);
+		return false;
 	}
+	output->cursor.hotspot_x = hotspot_x / (int)output->scale;
+	output->cursor.hotspot_y = hotspot_y / (int)output->scale;
 
 	if (wlr_buffer != NULL) {
 		struct wlr_wl_buffer *buffer =
@@ -938,11 +950,7 @@ static bool output_set_cursor(struct wlr_output *wlr_output,
 			return false;
 		}
 
-		if (output->cursor.viewport != NULL) {
-			wp_viewport_set_destination(output->cursor.viewport,
-				fmax(1, round(wlr_buffer->width / output->scale)),
-				fmax(1, round(wlr_buffer->height / output->scale)));
-		}
+		wl_surface_set_buffer_scale(surface, (int)output->scale);
 		wl_surface_attach(surface, buffer->wl_buffer, 0, 0);
 		wl_surface_damage_buffer(surface, 0, 0, INT32_MAX, INT32_MAX);
 		wl_surface_commit(surface);
@@ -977,9 +985,6 @@ static void output_destroy(struct wlr_output *wlr_output) {
 
 	wl_list_remove(&output->link);
 
-	if (output->cursor.viewport) {
-		wp_viewport_destroy(output->cursor.viewport);
-	}
 	if (output->cursor.surface) {
 		wl_surface_destroy(output->cursor.surface);
 	}
@@ -1034,12 +1039,46 @@ void update_wl_output_cursor(struct wlr_wl_output *output) {
 		assert(output->enter_serial);
 
 		struct wlr_wl_seat *seat = pointer->seat;
-		wl_pointer_set_cursor(seat->wl_pointer, output->enter_serial,
-			output->cursor.surface, output->cursor.hotspot_x,
-			output->cursor.hotspot_y);
+		if (output->cursor.shape != 0 && seat->cursor_shape_device != NULL) {
+			wp_cursor_shape_device_v1_set_shape(seat->cursor_shape_device,
+				output->enter_serial, output->cursor.shape);
+		} else {
+			wl_pointer_set_cursor(seat->wl_pointer, output->enter_serial,
+				output->cursor.surface, output->cursor.hotspot_x,
+				output->cursor.hotspot_y);
+		}
 	}
 }
 
+bool wlr_wl_output_set_cursor_name(struct wlr_output *wlr_output,
+		const char *name) {
+	struct wlr_wl_output *output = get_wl_output_from_output(wlr_output);
+	struct wlr_wl_backend *backend = output->backend;
+
+	uint32_t shape = 0;
+	if (name != NULL) {
+		if (backend->cursor_shape_manager == NULL) {
+			return false;
+		}
+		shape = cursor_shape_v1_from_name(name);
+		uint32_t version =
+			wp_cursor_shape_manager_v1_get_version(backend->cursor_shape_manager);
+		if (shape == 0 || (version < 2 &&
+				shape > WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_ZOOM_OUT)) {
+			return false;
+		}
+	} else if (output->cursor.surface != NULL) {
+		// Hide the host cursor until a new image is set
+		wl_surface_attach(output->cursor.surface, NULL, 0, 0);
+		wl_surface_commit(output->cursor.surface);
+	}
+
+	output->cursor.shape = shape;
+	update_wl_output_cursor(output);
+	wl_display_flush(backend->remote_display);
+	return true;
+}
+
 static bool output_move_cursor(struct wlr_output *_output, int x, int y) {
 	// TODO: only return true if x == current x and y == current y
 	return true;
