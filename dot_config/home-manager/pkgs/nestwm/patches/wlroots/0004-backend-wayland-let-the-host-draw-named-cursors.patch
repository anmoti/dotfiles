 #include "linux-dmabuf-v1-client-protocol.h"
@@ -417,6 +418,9 @@ static void registry_global(void *data, struct wl_registry *registry,
 	} else if (strcmp(iface, wp_viewporter_interface.name) == 0) {
 		wl->viewporter = wl_registry_bind(registry, name,
 			&wp_viewporter_interface, 1);
+	} else if (strcmp(iface, wp_cursor_shape_manager_v1_interface.name) == 0) {
+		wl->cursor_shape_manager = wl_registry_bind(registry, name,
+			&wp_cursor_shape_manager_v1_interface, version < 2 ? version : 2);
 	} else if (strcmp(iface, wp_fractional_scale_manager_v1_interface.name) == 0) {
 		wl->fractional_scale_manager = wl_registry_bind(registry, name,
 			&wp_fractional_scale_manager_v1_interface, 1);
@@ -557,6 +561,9 @@ static void backend_destroy(struct wlr_backend *backend) {
 	if (wl->viewporter) {
 		wp_viewporter_destroy(wl->viewporter);
 	}
+	if (wl->cursor_shape_manager) {
+		wp_cursor_shape_manager_v1_destroy(wl->cursor_shape_manager);
+	}
