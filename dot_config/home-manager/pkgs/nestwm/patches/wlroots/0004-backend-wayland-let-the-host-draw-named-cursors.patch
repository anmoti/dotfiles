diff --git a/include/types/wlr_cursor_shape_v1.h b/include/types/wlr_cursor_shape_v1.h
new file mode 100644
index 00000000..2210ed11
--- /dev/null
+++ b/include/types/wlr_cursor_shape_v1.h
@@ -0,0 +1,13 @@
+#ifndef TYPES_WLR_CURSOR_SHAPE_V1_H
+#define TYPES_WLR_CURSOR_SHAPE_V1_H
+
+#include <stdint.h>
+
+/**
+ * Returns the wp_cursor_shape_device_v1 shape with the given name, or 0 if
+ * unknown. Doesn't depend on the protocol headers, so that it can be used
+ * next to the client-side ones.
+ */
+uint32_t cursor_shape_v1_from_name(const char *name);
+
+#endif
diff --git a/include/wlr/backend/wayland.h b/include/wlr/backend/wayland.h
index c732de68..d4b1cb71 100644
--- a/include/wlr/backend/wayland.h
+++ b/include/wlr/backend/wayland.h
@@ -73,4 +73,12 @@ void wlr_wl_output_set_app_id(struct wlr_output *output, const char *app_id);
  */
 struct wl_surface *wlr_wl_output_get_surface(struct wlr_output *output);
 
+/**
+ * Lets the host compositor draw this output's cursor, named by a
+ * cursor-shape-v1 shape name (e.g. "default", "text"). Returns false if the
+ * host or the name isn't supported. NULL stops it and hides the host
+ * cursor; setting a cursor buffer on the output also stops it.
+ */
+bool wlr_wl_output_set_cursor_name(struct wlr_output *output, const char *name);
+
 #endif
diff --git a/types/wlr_cursor_shape_v1.c b/types/wlr_cursor_shape_v1.c
index 563b326e..e89e79bd 100644
--- a/types/wlr_cursor_shape_v1.c
+++ b/types/wlr_cursor_shape_v1.c
@@ -1,5 +1,6 @@
 #include <assert.h>
 #include <stdlib.h>
+#include <string.h>
 #include <wayland-server-core.h>
 #include <wayland-util.h>
 #include <wlr/types/wlr_cursor_shape_v1.h>
@@ -7,6 +8,7 @@
 #include <wlr/types/wlr_tablet_tool.h>
 
 #include "cursor-shape-v1-protocol.h"
+#include "types/wlr_cursor_shape_v1.h"
 #include "types/wlr_tablet_v2.h"
 
 #define CURSOR_SHAPE_MANAGER_V1_VERSION 2
@@ -263,6 +265,15 @@ static const char *const shape_names[] = {
 	[WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_ALL_RESIZE] = "all-resize",
 };
 
+uint32_t cursor_shape_v1_from_name(const char *name) {
+	for (size_t i = 1; i < sizeof(shape_names) / sizeof(shape_names[0]); i++) {
+		if (shape_names[i] != NULL && strcmp(shape_names[i], name) == 0) {
+			return i;
+		}
+	}
+	return 0;
+}
+
 const char *wlr_cursor_shape_v1_name(enum wp_cursor_shape_device_v1_shape shape) {
 	assert(shape < sizeof(shape_names) / sizeof(shape_names[0]));
 	return shape_names[shape];
