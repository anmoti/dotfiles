# Auto-generated by chezmoi from dot_config/nvim/lua/**/*.lua
# Do not edit this file directly; declare `{ "<cmd>", nix = "<pkg>" }` in the corresponding Lua file.
pkgs: with pkgs; [
{{- $files := list -}}
{{- range $pattern := list
  "dot_config/nvim/lua/configs/*.lua"
  "dot_config/nvim/lua/plugins/*.lua"
  "dot_config/nvim/lua/plugins/*/*.lua"
-}}
{{-   $files = concat $files (glob (printf "%s/%s" $.chezmoi.sourceDir $pattern)) -}}
{{- end -}}
{{- $seen := dict -}}
{{- range $file := ($files | sortAlpha | uniq) -}}
{{-   $rel := trimPrefix (printf "%s/dot_config/nvim/" $.chezmoi.sourceDir) $file -}}
{{-   range $line := splitList "\n" (include $file) -}}
{{-     if and (not (regexMatch "^\\s*--" $line)) (regexMatch "\\bnix\\s*=\\s*\"[^\"]+\"" $line) -}}
{{-       range $match := regexFindAll "\\bnix\\s*=\\s*\"[^\"]+\"" $line -1 -}}
{{-         $pkg := regexReplaceAll ".*\"([^\"]+)\".*" $match "$1" | trim -}}
{{-         if not (hasKey $seen $pkg) -}}
{{-           $_ := set $seen $pkg true }}
  {{ $pkg }} # {{ $rel }}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end }}
]
