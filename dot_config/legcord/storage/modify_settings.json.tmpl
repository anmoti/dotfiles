#!/usr/bin/env bash
# legcordが書き戻すキー(modCacheなど)は実機の値を残し、管理しているキーだけ上書きする
set -e
cur=$(cat)
[ -n "$cur" ] || cur='{}'
want=$(cat <<'EOF_JSON'
{{ includeTemplate "legcord-settings.json" . }}
EOF_JSON
)
# 代入にしておくと jq の失敗で set -e が効く。$(...) で末尾の改行を落とし、legcordの書式に揃える
out=$(jq --indent 4 --argjson want "$want" '. * $want' <<<"$cur")
printf '%s' "$out"
