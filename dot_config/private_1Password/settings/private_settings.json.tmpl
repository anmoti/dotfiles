{{- $cur := dict -}}
{{- $raw := "" -}}
{{- if stat .chezmoi.targetFile }}
{{    $raw = include .chezmoi.targetFile }}
{{    $cur = $raw | fromJson }}
{{  end -}}
{{- $want := includeTemplate "1Password-settings.json" . | fromJson -}}
{{- $res := mergeOverwrite (deepCopy $cur) $want -}}
{{- includeTemplate "keep-json-format" (dict "raw" $raw "res" $res "indent" "    ") -}}
