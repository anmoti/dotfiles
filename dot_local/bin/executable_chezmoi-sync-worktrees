#!/bin/bash
# Rebuild the overlay: main + every jj workspace's working copy (dirty files included).
# usage: chezmoi-sync-worktrees [source-dir]
set -euo pipefail

# hooks run on --dry-run too, but this rewrites the source dir
case " ${CHEZMOI_ARGS:-} " in *" --dry-run "* | *" -n "*) exit 0 ;; esac

# not `chezmoi source-path`: the parent chezmoi holds the state lock while hooks run
source_dir=${1:-${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}}
root=$(jj -R "$source_dir" root)
cd "$root"

# commits created here must not trigger the signing backend
jj=(jj --config signing.behavior=drop)

if [ -n "$(${jj[@]} diff -r @ --summary)" ]; then
  echo "sync: $root has unrouted changes; move them to a workspace first" >&2
  exit 1
fi

# main, then every other workspace's @ (except ones marked .chezmoi-nosync)
parents=(main)
skipped=()
while IFS= read -r ws; do
  [ -n "$ws" ] || continue
  [ "$ws" = "$root" ] && continue
  if [ -e "$ws/.chezmoi-nosync" ]; then
    skipped+=("$ws")
    continue
  fi
  # snapshot that workspace (snapshot.auto-update-stale handles a stale copy)
  ( cd "$ws" && jj --config signing.behavior=drop st >/dev/null 2>&1 ) || {
    echo "sync: cannot snapshot $ws" >&2
    exit 1
  }
  rev=$( cd "$ws" && jj log -r @ --no-graph -T 'commit_id' )
  [ -n "$rev" ] || { echo "sync: no working copy in $ws" >&2; exit 1; }
  parents+=("$rev")
done < <(${jj[@]} workspace list -T 'root ++ "\n"')

for ws in ${skipped[@]+"${skipped[@]}"}; do
  echo "sync: skip $ws (.chezmoi-nosync)" >&2
done

old_op=$(${jj[@]} op log --no-graph -n1 -T 'id')
old_change=$(${jj[@]} log -r @ --no-graph -T 'change_id')

${jj[@]} new "${parents[@]}" -m overlay >/dev/null

if [ "$(${jj[@]} log -r @ --no-graph -T 'conflict')" != "false" ]; then
  ${jj[@]} op restore "$old_op"
  echo "sync: conflict while merging workspaces; overlay left as before" >&2
  exit 1
fi

${jj[@]} abandon "$old_change" >/dev/null 2>&1 || true
echo "sync: overlay rebuilt from $(( ${#parents[@]} - 1 )) workspaces"
