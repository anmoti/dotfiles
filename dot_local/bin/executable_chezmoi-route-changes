#!/bin/bash
# chezmoi [hooks.add.post] / [hooks.re-add.post]:
# move what chezmoi just wrote into the source dir to a workspace with fzf,
# then rebuild the overlay.
set -euo pipefail

# hooks run on --dry-run too
case " ${CHEZMOI_ARGS:-} " in *" --dry-run "* | *" -n "*) exit 0 ;; esac

# not `chezmoi source-path`: the parent chezmoi holds the state lock while hooks run
source_dir=${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}
root=$(jj -R "$source_dir" root)
cd "$root"

changed() {
  jj diff -r @ --summary
}

move() {
  local ws=$1 lines=$2 status f
  local -a paths=()
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    status=${line%% *}
    f=${line#* }
    if [ "$status" = "D" ]; then
      rm -f "$ws/$f"
    else
      # don't clobber a different version in the destination
      if [ -e "$ws/$f" ] && ! cmp -s "$root/$f" "$ws/$f"; then
        echo "route: skip $f (differs in $ws)" >&2
        continue
      fi
      mkdir -p "$ws/$(dirname "$f")"
      cp -a "$root/$f" "$ws/$f"
    fi
    paths+=("$f")
  done <<<"$lines"

  [ ${#paths[@]} -gt 0 ] || return 0
  # drop them from the overlay, then snapshot the destination workspace
  jj restore -- "${paths[@]}"
  ( cd "$ws" && jj --config signing.behavior=drop st >/dev/null )
}

while [ -n "$(changed)" ]; do
  files=$(changed | fzf --multi --prompt='files> ' \
    --header='Tab: select / Enter: choose workspace / Esc: stop') || break
  [ -n "$files" ] || break
  ws=$(jj workspace list -T 'name ++ "\t" ++ root ++ "\n"' | grep -vF "	$root" |
    fzf --prompt='move to> ' --header='Esc: back to file selection' | cut -f2-) || continue
  [ -n "$ws" ] || continue
  move "$ws" "$files"
done

if [ -n "$(changed)" ]; then
  echo "route: changes remain in $root; overlay is not rebuilt" >&2
  exit 0
fi

"$(dirname "$0")/chezmoi-sync-worktrees" "$root"
